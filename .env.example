# ---------------------------------------------------------------------------
# Environment variables for the portfolio.
#
# Local use:  copy to `.env.local` (git-ignored) and fill in real values.
# Vercel:     Project ▸ Settings ▸ Environment Variables — the production
#             deployment (varunbp-portfolio.vercel.app) already reads these
#             from the project settings. Never commit real values.
# ---------------------------------------------------------------------------

# Contact form, option 1 (client-side, Web3Forms) — the primary method, and
# the same one the earlier portfolio used. When set, the form posts directly
# to https://api.web3forms.com. The access key is public-by-design (it is a
# form key, not a secret API key), so having it in the built client is fine.
# When unset, the form falls back to /api/contact below.
VITE_WEB3FORMS_KEY=

# Contact form, option 2 (server-side, Vercel function `api/contact.js`
# using Resend) — the backup path. Without it the endpoint answers 503 and the
# UI shows an inline error naming the email address; it never opens the
# visitor's mail client and never silently drops a message.
RESEND_API_KEY=
